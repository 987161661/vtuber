{
  "name": "@aituber-onair/soul-sqlite",
  "version": "0.0.1",
  "private": true,
  "description": "Durable SQLite ledger and transactional outbox adapter for the soul runtime.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "engines": {
    "node": ">=24.2.0"
  },
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc --project tsconfig.json",
    "typecheck": "tsc --noEmit --project tsconfig.dev.json",
    "test": "npm run typecheck && vitest run && npm run build",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@aituber-onair/soul": "0.0.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.0.0",
    "vitest": "^1.3.1"
  }
}
