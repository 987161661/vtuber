{
  "name": "@aituber-onair/tool-sandbox-wasi",
  "version": "0.0.1",
  "private": true,
  "description": "Default-deny WASI sandbox adapter for local AI tools.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "engines": { "node": ">=24.0.0" },
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc --project tsconfig.json",
    "typecheck": "tsc --noEmit --project tsconfig.dev.json",
    "test": "npm run typecheck && vitest run && npm run build"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.0.0",
    "vitest": "^1.3.1"
  }
}
